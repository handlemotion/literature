{
  "name": "literature",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint packages && pnpm --filter demo lint",
    "lint:fix": "oxlint --fix packages && pnpm --filter demo lint:fix",
    "format": "oxfmt --check packages && pnpm --filter demo format",
    "format:fix": "oxfmt packages && pnpm --filter demo format:fix",
    "check-types": "turbo run check-types",
    "test": "turbo run test --filter=@handlemotion/literature-cli",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm turbo build --filter=@handlemotion/literature... --filter=@handlemotion/literature-cli && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.50.0",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
