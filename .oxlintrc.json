{
  "plugins": ["typescript", "import", "react", "nextjs"],
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "eslint/no-underscore-dangle": ["warn", { "allow": ["__lit"] }]
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/pnpm-lock.yaml"
  ],
  "overrides": [
    {
      "files": [
        "packages/literature/src/core/**",
        "packages/literature/src/compiler/**",
        "packages/literature/src/next/**"
      ],
      "env": { "node": true, "browser": false }
    },
    {
      "files": ["packages/literature/src/client/**", "packages/ui/**"],
      "env": { "browser": true, "node": false }
    }
  ]
}
