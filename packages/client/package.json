{
  "name": "@handleui/literature-client",
  "version": "0.0.0",
  "description": "Literature in-canvas overlay, selection, and runtime markers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handleui/literature.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": false
  },
  "files": ["dist"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lit": {
      "types": "./dist/lit.d.ts",
      "import": "./dist/lit.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@handleui/literature-core": "workspace:*",
    "lucide-react": "^0.547.0"
  },
  "devDependencies": {
    "@handleui/literature-typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
