  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "recast": "^0.23.9"
  },
  "devDependencies": {
    "@handleui/literature-typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "tsup": "^8.5.0",
    "typescript": "5.9.2"
  }
