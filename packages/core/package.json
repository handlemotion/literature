{
  "name": "@handleui/literature-core",
  "version": "0.0.0",
  "description": "Literature targets, recast patch, and JSONL edit history",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handleui/literature.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
