{
  "name": "@handlemotion/literature-compiler",
  "version": "0.0.0",
  "description": "Literature Babel plugin and Vite/Turbopack compiler integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handleui/literature.git",
    "directory": "packages/compiler"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": false
  },
  "files": ["dist"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./babel": {
      "import": "./dist/babel-plugin-literature.js"
    },
    "./literature-loader.cjs": {
      "require": "./dist/literature-loader.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.28.0",
    "@handlemotion/literature-core": "workspace:*",
    "unplugin": "^2.3.5"
  },
  "devDependencies": {
    "@handlemotion/literature-typescript-config": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.15.3",
    "tsup": "^8.5.0",
    "typescript": "5.9.2"
  }
}
