{
  "name": "@handleui/literature-next",
  "version": "0.0.0",
  "description": "Literature dev-only copywriting for Next.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handleui/literature.git",
    "directory": "packages/next"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": false
  },
  "files": ["dist"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./devtools": {
      "types": "./dist/LiteratureDevtools.d.ts",
      "import": "./dist/LiteratureDevtools.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@handleui/literature-client": "workspace:*",
    "@handleui/literature-compiler": "workspace:*",
    "@handleui/literature-core": "workspace:*"
  },
  "devDependencies": {
    "@handleui/literature-typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "next": "16.2.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "next": ">=14"
  }
}
